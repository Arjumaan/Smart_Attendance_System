# Enterprise Smart Attendance System - Environment Configuration
# Copy this file to .env and configure for your local environment

PROJECT_NAME="Enterprise Smart Attendance System"
API_V1_STR="/api/v1"

# Cryptography & Security Keys
# Generate a secure 32+ byte string for JWT signing:
SECRET_KEY="generate-a-strong-random-32-byte-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AES-256 Key for Biometric Vector Encryption at Rest (Base64-encoded 32-byte key or 64-char hex)
# Example: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
BIOMETRIC_ENCRYPTION_KEY="k8Gj9b0+y3DqV2z7sW8m4X5p1R9n6T0vA3c5E7g8J1k="

# Database Configuration
# Use SQLite for standalone/dev/test or PostgreSQL for production
DATABASE_URL="sqlite:///./attendance.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/smart_attendance"

POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="password"
POSTGRES_DB="smart_attendance"
POSTGRES_PORT=5432

# Attendance Business Rules
SHIFT_START_TIME="09:15"
COOLDOWN_MINUTES=5
SIMILARITY_THRESHOLD=0.75

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
